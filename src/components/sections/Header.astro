<header
    class="header flex flex-col bg-[url(/bg-paper.png)] bg-cover before:block before:absolute before:inset-0 before:bg-white/30"
>
    <div
        class="container relative flex items-center flex-col justify-around h-[calc(100dvh+10px)]"
    >
        <div class="relative pr-12 pb-16 md:pr-24">
            <h1 class="font-decorate text-9xl md:text-8xl font-bold text-primary-dark">
                <span class="block line">Пора</span>
                <span class="line flex items-start"
                    >Что-то<span class="text-accent-dark py-4 text-7xl md:text-5xl md:py-1">*</span
                    ></span
                >
                <span class="block line">Менять</span>
            </h1>
            <h2
                class="absolute bottom-0 right-0 text-5xl font-decorate-2 text-accent-dark"
            >
                *СТРИЖКУ
            </h2>
        </div>
        <svg
            class="w-20 text-primary-dark"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 -960 960 960"
            fill="currentColor"
            ><path
                d="M459-381 314-526q-3-3-4.5-6.5T308-540q0-8 5.5-14t14.5-6h304q9 0 14.5 6t5.5 14q0 2-6 14L501-381q-5 5-10 7t-11 2q-6 0-11-2t-10-7Z"
            ></path></svg
        >
    </div>


    <script>
        import gsap from "gsap";

        const init = () => {
            const h1 = document.querySelector(".header h1");
            const lines = gsap.utils.toArray(".header .line");
            const strizhku = document.querySelector(".header h2");
            const isDesktop = window.matchMedia("(min-width: 768px)").matches;

            if (h1)
                gsap.set(lines, {
                    opacity: isDesktop ? 0 : 1,
                    x: isDesktop ? -100 : "-100vw",
                    willChange: "transform, opacity",
                });
            gsap.set(strizhku, {
                opacity: 0,
                y: -10,
                willChange: "transform, opacity",
            });

            const play = () => {
                const tl = gsap.timeline({ delay: 0.3 });

                tl.to(lines, {
                    x: 0,
                    duration: 1.1,
                    stagger: 0.3,
                    opacity: 1,
                    ease: "back.out(0.6)",
                });

                tl.to(
                    strizhku,
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.9,
                    },
                    "+=0.2",
                );
            };

            if (document.documentElement.classList.contains("is-ready")) {
                play();
            } else {
                document.addEventListener("app:ready", play, { once: true });
            }
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init, { once: true });
        } else {
            init();
        }
    </script>
</header>
