---
import Byn from "../Byn.astro";
import PriceLine from "./Price/PriceLine.astro";
---

<section id="price" class="price mt-6">
    <div class="container flex flex-col gap-6">
        <!-- <h2
            class="text-center text-5xl font-decorate font-bold text-primary-dark"
        >
            Прайс-лист
        </h2> -->
        <div class="w-full">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-24 h-24 -translate text-primary-dark mx-auto"
                viewBox="0 0 32 32"
            >
                <path d="M0 0h32v32H0z" fill="none"></path>
                <path
                    fill="currentColor"
                    d="M23 20.515c0-4.615-3.78-5.141-6.817-5.563c-3.31-.46-5.183-.86-5.183-3.71C11 8.85 13.507 8 15.654 8a6.75 6.75 0 0 1 5.568 2.628l1.556-1.256A8.65 8.65 0 0 0 17 6.096V3h-2v3.022c-3.615.22-6 2.26-6 5.22c0 4.73 3.83 5.263 6.908 5.69c3.252.453 5.092.842 5.092 3.583C21 23.547 17.867 24 16 24c-3.43 0-4.878-.964-6.222-2.628l-1.556 1.256A8.44 8.44 0 0 0 15 25.965V29h2v-3.045c3.726-.304 6-2.327 6-5.44"
                ></path>
            </svg>
        </div>
        <div class="price__line w-full h-1 bg-primary-dark origin-center"></div>

        <div class="price__block w-full px-1 space-y-3">
            <h3 class="font-decorate font-bold text-4xl">
                Холодное восстановление
            </h3>

            <div class="space-y-3 text-sm md:text-base opacity-80">
                <p>
                    Глубокое восстановление связей внутри волоса на молекулярном
                    уровне. Не выпрямляет, а лечит: возвращает волосы после
                    осветлений, неудачных окрашиваний и химических завивок.
                </p>
                <p class="text-sm font-medium pt-1 italic">
                    Подходит беременным, кормящим и детям
                </p>
            </div>

            <div class="flex flex-col gap-3">
                <PriceLine price="70" length="20" />
                <PriceLine price="80" length="30" />
                <PriceLine price="90" length="40" />
                <PriceLine price="100" length="50" />
                <PriceLine price="130" length="60" />
                <PriceLine price="160" length="70" />
            </div>
        </div>

        <div class="w-full h-0.5 bg-primary-dark"></div>

        <div class="price__block w-full px-1 space-y-3">
            <div class="flex font-decorate font-bold text-4xl justify-between">
                <h3>Укладка</h3>
                <span>30–45 BYN</span>
            </div>

            <p class="opacity-80">Мытье, сушка по форме стрижки и стайлинг</p>
        </div>
        <div class="w-full h-0.5 bg-primary-dark"></div>

        <div class="price__block w-full px-1 space-y-3">
            <div class="flex font-decorate font-bold text-4xl justify-between">
                <h3>Локоны</h3>
                <span>40–70 BYN</span>
            </div>

            <p class="opacity-80">(В зависимости от длины и густоты волос)</p>
        </div>
        <div class="w-full h-0.5 bg-primary-dark"></div>

        <div class="price__block w-full px-1 space-y-3">
            <div class="flex font-decorate font-bold text-4xl justify-between">
                <h3>Причёска</h3>
                <span>60-80 BYN</span>
            </div>

            <p class="opacity-80">Шпильки, невидимки, стайлинг и прочее входит в стоимость</p>
        </div>
    </div>
</section>

    <script>
        import gsap from "gsap";
        import ScrollTrigger from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const line = document.querySelector<HTMLElement>(".price__line");
        const blocks = gsap.utils.toArray<HTMLElement>(".price__block");

        if (line) gsap.set(line, { scaleX: 0 });
        gsap.set(blocks, { opacity: 0, y: -40 });

        const init = () => {
            if (line) {
                gsap.to(line, {
                    scaleX: 1,
                    duration: 1,
                    ease: "power2.inOut",
                    scrollTrigger: {
                        trigger: ".price",
                        start: "top 60%",
                        once: true,
                    },
                });
            }

            blocks.forEach((block, index) => {
                gsap.to(block, {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    ease: "power1.out",
                    delay: index === 0 ? 0.6 : 0,
                    scrollTrigger: {
                        trigger: block,
                        start: "top 60%",
                        once: true,
                    },
                });
            });

            ScrollTrigger.refresh();
        };

        if (document.documentElement.classList.contains("is-ready")) {
            init();
        } else {
            document.addEventListener("app:ready", init, { once: true });
        }
    </script>
</section>
