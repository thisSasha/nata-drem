---
import { Image } from "astro:assets";
import "photoswipe/style.css";
import { PORTFOLIO } from "../../assets/portfolio/portfolio.ts";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/portfolio/*.{jpg,jpeg,JPG,JPEG,png,webp,PNG,WEBP}",
    { eager: true },
);

const images = Object.entries(imageModules).map(([path, mod]) => {
    const filename = path.split("/").pop()?.split(".")[0] || "";
    return {
        src: mod.default,
        fullSrc: mod.default.src,
        width: mod.default.width,
        height: mod.default.height,
        filename: filename,
    };
});
---

<section class="portfolio mt-16" id="portfolio">
    <div class="container">
        <h2 class="text-center text-5xl font-bold font-decorate mb-8 text-accent-dark">
            Мои работы
        </h2>
        <div class="portfolio__content">
            <div class="grid grid-cols-4 gap-0.5 bg-accent-dark border-2 border-accent-dark rounded-full overflow-hidden">
                <button data-filter="style" class="portfolio__button">Причёски</button>
                <button data-filter="cut" class="portfolio__button">Стрижки</button>
                <button data-filter="contour" class="portfolio__button">Контуринг</button>
                <button data-filter="curls" class="portfolio__button">Кудри</button>
            </div>
            <div class="portfolio__images grid content-start grid-cols-2 mt-4 rounded-xl overflow-hidden">
                {
                    images.map((img) => (
                        <a
                            class="portfolio__item block cursor-zoom-in transition-opacity duration-300"
                            href={img.fullSrc}
                            data-pswp-width={img.width}
                            data-pswp-height={img.height}
                            data-pswp-cropped="true"
                            data-property={PORTFOLIO[img.filename]}
                        >
                            <Image
                                class:list={
                                    "portfolio__image block w-full aspect-square object-cover"
                                }
                                quality={100}
                                width={400}
                                alt={""}
                                src={img.src}
                                fetchpriority={"low"}
                                loading={"eager"}
                            />
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
    <script>
        import PhotoSwipeLightbox from "photoswipe/lightbox";
        import gsap from "gsap";
        import ScrollTrigger from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const content = document.querySelector<HTMLElement>(".portfolio__content");
        if (content) gsap.set(content, { opacity: 0 });

        const initPortfolioReveal = () => {
            if (!content) return;

            gsap.to(content, {
                opacity: 1,
                duration: 0.9,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: content,
                    start: "top 60%",
                    once: true,
                },
            });

            ScrollTrigger.refresh();
        };

        if (document.documentElement.classList.contains("is-ready")) {
            initPortfolioReveal();
        } else {
            document.addEventListener("app:ready", initPortfolioReveal, {
                once: true,
            });
        }

        const lightbox = new PhotoSwipeLightbox({
            gallery: ".portfolio__images",
            children: "a.portfolio__item",
            pswpModule: () => import("photoswipe"),
            bgOpacity: 0.92,
            showAnimationDuration: 300,
            hideAnimationDuration: 300,
            paddingFn: (viewportSize) => ({
                top: viewportSize.y * 0.06,
                bottom: viewportSize.y * 0.06,
                left: 0,
                right: 0,
            }),
        });

        lightbox.on("beforeOpen", () => {
            document.documentElement.classList.add("lightbox-locked");
        });

        lightbox.on("closingAnimationEnd", () => {
            document.documentElement.classList.remove("lightbox-locked");
        });

        lightbox.init();

        const imgs = document.querySelectorAll(".portfolio__item") as NodeListOf<HTMLElement>;

        imgs.forEach((item) => {
            item.querySelector("img")?.decode().catch(() => {});
        });

        const btns = document.querySelectorAll(".portfolio__button") as NodeListOf<HTMLElement>;
        const container = document.querySelector(".portfolio__images") as HTMLElement;

        const FADE_DURATION = 300;

        const filters: Record<string, boolean> = {};

        const wait = (ms: number) =>
            new Promise<void>((resolve) => setTimeout(resolve, ms));

        const getActive = () => Object.keys(filters).filter((k) => filters[k]);

        const matchesFilters = (img: HTMLElement, active: string[]) => {
            if (active.length === 0) return true;
            return active.some((f) => img.dataset.property?.includes(f));
        };

        const syncButtons = () => {
            btns.forEach((btn) => {
                const f = btn.dataset.filter;
                if (f) {
                    btn.classList.toggle("portfolio__button--active", !!filters[f]);
                }
            });
        };

        let animating = false;

        btns.forEach((btn) => {
            btn.addEventListener("click", async () => {
                if (animating) return;

                const filter = btn.dataset.filter;
                if (!filter) return;

                // Переключаем фильтр (без сброса старых)
                filters[filter] = !filters[filter];
                syncButtons();

                const active = getActive();

                // --- Анимация ---
                animating = true;

                const startHeight = container.offsetHeight;
                container.style.height = `${startHeight}px`;
                container.style.overflow = "hidden";
                container.style.transition = "none";

                // 1. Плавно гасим всё, что сейчас видно
                imgs.forEach((img) => {
                    if (!img.classList.contains("hidden")) {
                        img.classList.add("opacity-0");
                    }
                });

                await wait(FADE_DURATION);

                // 2. Резко меняем hidden
                imgs.forEach((img) => {
                    if (matchesFilters(img, active)) {
                        img.classList.remove("hidden");
                    } else {
                        img.classList.add("hidden");
                    }
                });

                lightbox.options.children = Array.from(imgs).filter(
                    (img) => !img.classList.contains("hidden"),
                );

                // Форсируем reflow, чтобы браузер зафиксировал новую раскладку
                void container.offsetHeight;

                // 3. Плавно проявляем выбранные
                imgs.forEach((img) => {
                    if (!img.classList.contains("hidden")) {
                        img.classList.remove("opacity-0");
                    }
                });

                await wait(FADE_DURATION);

                // 4. После появления — плавно меняем высоту под новое число карточек
                container.style.height = "auto";
                const newHeight = container.offsetHeight;
                container.style.height = `${startHeight}px`;
                void container.offsetHeight;

                container.style.transition = `height ${FADE_DURATION}ms ease`;
                container.style.height = `${newHeight}px`;

                await wait(FADE_DURATION + 20);

                container.style.height = "";
                container.style.transition = "";
                container.style.overflow = "";

                animating = false;
            });
        });
    </script>
</section>

<style is:global>
    html.lightbox-locked,
    html.lightbox-locked body {
        overflow: hidden;
    }
</style>