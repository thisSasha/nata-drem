---
import { Font } from "astro:assets";
---
<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add("is-oading");
		</script>
		<style is:inline>
			html.is-loading,
			html.is-loading body {
				overflow: hidden;
			}

			#app {
				opacity: 0;
			}

			html.is-ready #app {
				opacity: 1;
				transition: opacity 0.45s ease;
			}

			.preloader {
				position: fixed;
				inset: 0;
				z-index: 9999;
				display: grid;
				place-items: center;
				background: #f6f5f5;
				opacity: 1;
				visibility: visible;
				transition: opacity 0.45s ease, visibility 0.45s ease;
			}

			.preloader.is-hidden {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
			}

			.preloader__spinner {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				background: conic-gradient(
					from 0deg,
					#68ac10 0deg 150deg,
					transparent 150deg 180deg,
					#ff6d62 180deg 330deg,
					transparent 330deg 360deg
				);
				-webkit-mask: radial-gradient(
					farthest-side,
					transparent calc(100% - 6px),
					#000 calc(100% - 6px)
				);
				mask: radial-gradient(
					farthest-side,
					transparent calc(100% - 6px),
					#000 calc(100% - 6px)
				);
				animation: preloader-spin 1.1s linear infinite;
			}

			@keyframes preloader-spin {
				to {
					transform: rotate(1turn);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.preloader__spinner {
					animation-duration: 2.4s;
				}
			}
		</style>
		<Font cssVariable="--font-main" preload />
		<Font cssVariable="--font-decorate" preload />
		<Font cssVariable="--font-decorate-2" preload />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Ната Дрем | Молодечно</title>
		<link rel="preload" as="image" href="/bg-paper.png" />
	</head>
	<body>
		<div class="preloader" id="preloader" role="status" aria-label="Загрузка">
			<div class="preloader__spinner"></div>
		</div>
		<noscript>
			<style>
				#app {
					opacity: 1 !important;
				}
				#preloader {
					display: none !important;
				}
			</style>
		</noscript>
		<div id="app">
			<slot />
		</div>
		<script is:inline>
			(() => {
				const html = document.documentElement;
				const loader = document.getElementById("preloader");
				let revealed = false;

				const reveal = () => {
					if (revealed) return;
					revealed = true;

					document.dispatchEvent(new CustomEvent("app:ready"));
					html.classList.add("is-ready");
					html.classList.remove("is-loading");

					if (!loader) return;
					loader.classList.add("is-hidden");
					loader.addEventListener("transitionend", () => loader.remove(), {
						once: true,
					});
					setTimeout(() => loader.remove(), 900);
				};

				const fontsReady =
					document.fonts && document.fonts.ready
						? document.fonts.ready
						: Promise.resolve();
				const windowReady =
					document.readyState === "complete"
						? Promise.resolve()
						: new Promise((resolve) =>
								window.addEventListener("load", resolve, { once: true }),
							);

				Promise.all([fontsReady, windowReady]).then(() => {
					setTimeout(() => {
						requestAnimationFrame(() => requestAnimationFrame(reveal));
					}, 350);
				});

				setTimeout(reveal, 8000);
			})();
		</script>
	</body>
</html>
